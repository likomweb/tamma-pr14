# Public site URL used for canonical links, sitemap, robots, Open Graph, and structured data.
# Set this to the final HTTPS domain before deployment.
NEXT_PUBLIC_SITE_URL=https://www.tamma-services.dz

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email Notification
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_EMAIL_TO=commercial@tamma-services.dz
NOTIFICATION_EMAIL_FROM=TAMMA System <onboarding@resend.dev>

# Designated Administrator
ADMIN_EMAIL=commercial@tamma-services.dz
